# TableServe configuration. Copy to .env and adjust. Never commit a real .env file.

# Public base URL used inside table QR codes and invitation links. Must be the address
# guests' phones can reach (in production: your HTTPS domain).
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# SQLite database file and uploaded images directory.
DATABASE_FILE=./data/tableserve.db
UPLOAD_DIR=./uploads

# 32+ random characters. Encrypts restaurants' payment-gateway secrets at rest (AES-256-GCM).
# REQUIRED when NODE_ENV=production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DATA_ENCRYPTION_KEY=

# Cookies are marked Secure automatically in production; override if needed.
# COOKIE_SECURE=true
# Set to true when running behind a reverse proxy / load balancer (correct client IPs for rate limits).
# TRUST_PROXY=false

# Built-in simulated payment gateway ("TEST MODE"). Enabled by default outside production.
# Set to false in production so only real gateways (Razorpay) are offered.
ALLOW_TEST_PAYMENTS=true
# Signing secret for the simulated gateway's webhooks (random string).
TEST_GATEWAY_SECRET=

# Load clearly labelled demo data into an empty database on first start.
SEED_DEMO=true

# Razorpay keys are NOT configured here: each restaurant owner enters their own Key ID,
# Key Secret and Webhook Secret under Company & payments → Payment methods.
